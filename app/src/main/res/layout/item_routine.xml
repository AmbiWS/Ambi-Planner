<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/routineHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="8dp"
        android:background="@drawable/rounded_item_bg">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextClassic14"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Jogging" />

        <TextView
            android:id="@+id/tvDescription"
            style="@style/TextSecondary14"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toStartOf="@+id/tvTimeLeft"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            tools:text="Go for a run around the block" />

        <TextView
            android:id="@+id/tvStart"
            style="@style/TextClassic14"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            app:layout_constraintBottom_toTopOf="@id/tvCompletionTime"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvTimeLeft"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription"
            app:layout_goneMarginBottom="12dp"
            tools:text="Start at 12:20" />

        <TextView
            android:id="@+id/tvTimeLeft"
            style="@style/TextSecondary14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTitle"
            tools:text="Time left 00:05:20" />

        <TextView
            android:id="@+id/tvCompletionTime"
            style="@style/TextSecondary14"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvTimeLeft"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvStart"
            tools:text="30m on Completion" />

        <CheckBox
            android:id="@+id/cbDone"
            style="@style/TextClassic14"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="-6dp"
            android:buttonTint="@color/black"
            android:scaleX="0.8"
            android:scaleY="0.8"
            android:text="@string/done"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvCompletionTime"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_goneMarginBottom="8dp"
            tools:checked="true" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>